# --- Supabase (server-side only: NEVER prefix these with NEXT_PUBLIC_) ---
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Service role / secret key. Used only inside API routes; bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key
SUPABASE_STORAGE_BUCKET=documents

# --- AI Provider ('evren' | 'ollama'; defaults to 'evren' when EVREN_API_KEY is set) ---
AI_PROVIDER=evren

# --- EVREN AI (https://evren.ssyz.org.tr) ---
EVREN_BASE_URL=https://evren-llmapi.ssyz.org.tr/v1
EVREN_API_KEY=evren_llm_your_api_key_here
# Use 'auto' or any model ID returned by GET /v1/models (e.g. glm-5.3, deepseek-v4-flash, qwen3.8-flash-next, gemma-4-31b)
EVREN_MODEL=auto

# --- Ollama (Local fallback when AI_PROVIDER=ollama) ---
OLLAMA_BASE_URL=http://localhost:11434
# Must be a TOOL-CAPABLE model: llama3.1, llama3.2, qwen2.5, phi4-mini ...
# (original llama3 and phi3 do NOT support tool calling in Ollama)
OLLAMA_MODEL=qwen2.5:7b
